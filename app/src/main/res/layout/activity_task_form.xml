<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homepet_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_form_title"
            android:textColor="@color/homepet_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/petNameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_login_input"
            android:hint="@string/pet_name_hint"
            android:inputType="textPersonName"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/taskTypeInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_input"
            android:hint="@string/task_type_hint"
            android:inputType="textCapSentences"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/dueDateInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_input"
            android:hint="@string/due_date_hint"
            android:inputType="date"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/priorityInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_input"
            android:hint="@string/priority_hint"
            android:inputType="textCapWords"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/notesInput"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_input"
            android:gravity="top"
            android:hint="@string/notes_hint"
            android:inputType="textMultiLine"
            android:padding="18dp" />

        <CheckBox
            android:id="@+id/completedCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/completed_task"
            android:textColor="@color/homepet_text" />

        <Button
            android:id="@+id/saveTaskButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="@string/save_task"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/deleteTaskButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_help_button"
            android:backgroundTint="@null"
            android:text="@string/delete_task"
            android:textAllCaps="false"
            android:textColor="@color/homepet_primary"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
