<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homepet_background"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_location"
        android:textColor="@color/homepet_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mapConfigurationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/maps_key_missing"
        android:textColor="@color/homepet_text"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/selectedCoordinatesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/tap_map_location"
        android:textColor="@color/homepet_text_muted" />

    <EditText
        android:id="@+id/locationNameInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_login_input"
        android:hint="@string/location_name_hint"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/homepet_text"
        android:textColorHint="@color/homepet_text_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelLocationButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/confirmLocationButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="@string/confirm_location"
            android:textAllCaps="false"
            android:textColor="@color/homepet_on_primary" />
    </LinearLayout>
</LinearLayout>
