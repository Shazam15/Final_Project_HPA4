<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_task_item"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/rewardImage"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/reward_preview"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/rewardNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/homepet_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rewardTypeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/homepet_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rewardDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/homepet_text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/rewardActionButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:textAllCaps="false" />
</LinearLayout>
