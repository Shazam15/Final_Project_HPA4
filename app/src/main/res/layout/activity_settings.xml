<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homepet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/homepet_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/petNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_login_input"
            android:hint="@string/pet_name"
            android:inputType="textPersonName"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/select_pet_type"
            android:textColor="@color/homepet_text"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/petTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_login_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <CheckBox
            android:id="@+id/notificationsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/notifications"
            android:textColor="@color/homepet_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/theme_mode"
            android:textColor="@color/homepet_text"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/themeSpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_login_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <EditText
            android:id="@+id/reminderHourInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="@string/reminder_hour"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_save_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/homepet_on_primary"
            android:text="@string/save_settings"
            android:textAllCaps="false"
            android:textColor="@color/homepet_on_primary" />

        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/share_progress"
            android:textAllCaps="false"
            android:textColor="@color/homepet_primary"
            app:backgroundTint="@color/homepet_surface"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_share_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/homepet_primary"
            app:strokeColor="@color/homepet_primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/reset_progress"
            android:textAllCaps="false"
            android:textColor="@color/homepet_primary"
            app:backgroundTint="@color/homepet_surface"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_reset_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/homepet_primary"
            app:strokeColor="@color/homepet_primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/logout"
            android:textAllCaps="false"
            android:textColor="@color/homepet_primary"
            app:backgroundTint="@color/homepet_surface"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_logout_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/homepet_primary"
            app:strokeColor="@color/homepet_primary"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
