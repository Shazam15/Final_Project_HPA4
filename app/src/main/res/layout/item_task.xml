<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_task_item"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/taskStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_help_button"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/homepet_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/taskTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/homepet_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/taskMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/homepet_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/taskDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/homepet_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/taskLocationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/homepet_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/openLocationButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="@string/open_in_maps"
        android:textAllCaps="false"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/completeTaskButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            android:textColor="@color/homepet_on_primary" />

        <Button
            android:id="@+id/editTaskButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_help_button"
            android:backgroundTint="@null"
            android:text="@string/edit_task"
            android:textAllCaps="false"
            android:textColor="@color/homepet_primary" />

        <Button
            android:id="@+id/deleteTaskButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_help_button"
            android:backgroundTint="@null"
            android:text="@string/delete_task"
            android:textAllCaps="false"
            android:textColor="@color/homepet_primary" />
    </LinearLayout>
</LinearLayout>
