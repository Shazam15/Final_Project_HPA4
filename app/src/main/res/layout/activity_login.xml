<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homepet_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="34dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/homepet_title"
            android:textColor="@color/homepet_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/homepet_subtitle"
            android:textColor="@color/homepet_text_muted"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/petImageContainer"
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pet_circle"
            android:padding="12dp">

            <ImageView
                android:id="@+id/petImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/homepet_pet_image"
                android:scaleType="centerCrop"
                android:src="@drawable/homepet_pet" />
        </FrameLayout>

        <TextView
            android:id="@+id/loginTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/login_title"
            android:textColor="@color/homepet_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:autofillHints="name"
            android:background="@drawable/bg_login_input"
            android:hint="@string/name_hint"
            android:inputType="textPersonName"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/homepet_text"
            android:textColorHint="@color/homepet_text_muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_login_input"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/homepet_text"
            android:textColorHint="@color/homepet_text_muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:autofillHints="password"
            android:background="@drawable/bg_login_input"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/homepet_text"
            android:textColorHint="@color/homepet_text_muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="@string/login_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/helpButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_help_button"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_phone_24"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="@string/request_help_button"
            android:textAllCaps="false"
            android:textColor="@color/homepet_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
