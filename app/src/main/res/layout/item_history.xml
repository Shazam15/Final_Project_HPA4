<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_task_item"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/historyTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/homepet_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/historyDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/homepet_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/historyDateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/homepet_text_muted"
        android:textSize="12sp" />
</LinearLayout>
